    "Share a full conversation log as a JSON file. Your Device ID is included so your identity can be restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将完整对话记录分享为 JSON 文件。包含您的设备 ID，以便在新设备上恢复身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將完整對話記錄分享為 JSON 檔案。包含您的裝置 ID，以便在新裝置上還原身份。"
          }
        }
      }
    },
    "Share this ID to restore your identity on a new device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享此 ID 以在新设备上恢复您的身份。"
